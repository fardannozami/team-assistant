{
  "name": "hermes-bridge",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --env-file=../../.env run --hot src/index.ts",
    "build": "bun build src/index.ts --compile --target=bun-linux-x64 --outfile dist/hermes-bridge",
    "start": "bun --env-file=../../.env run src/index.ts",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "hono": "4.6.14"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/bun": "1.2.0",
    "eslint": "10.9.1",
    "typescript": "7.0.2",
    "@babel/core": "8.0.1",
    "@babel/eslint-parser": "8.0.1",
    "@babel/preset-typescript": "8.0.0"
  }
}

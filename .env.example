# Database
DATABASE_URL=postgres://teamassistant:teamassistant@localhost:5432/teamassistant

# Redis
REDIS_URL=redis://localhost:6379

# API
PORT=4000
NODE_ENV=development

# Web app URL (Google login redirects back here)
WEB_URL=http://localhost:3000

# Google OAuth login (leave empty to hide "Masuk dengan Google").
# Unknown Google accounts get their own new workspace as Owner. Set false to
# allow only existing users.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
GOOGLE_SIGNUP_ENABLED=true

# WhatsApp (Baileys). Each workspace's bot session is stored in its own
# subdirectory of WHATSAPP_SESSIONS_DIR.
WHATSAPP_SESSIONS_DIR=./data/whatsapp-sessions
# Legacy single-bot session path; only migrated into a workspace on first start.
WHATSAPP_SESSION_PATH=./data/whatsapp-session

# AI provider (OpenAI-compatible)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Internal API access (worker -> api). Change INTERNAL_API_TOKEN in production.
INTERNAL_API_URL=http://localhost:4000
INTERNAL_API_TOKEN=dev-internal-token

# Standup schedules are per workspace (each new workspace gets 09:00 Mon-Fri).
# Daily report sent to each workspace's admins (worker).
DAILY_REPORT_CRON=0 17 * * 1-5

# Include Owner/Admin employees in automatic standup prompts (default false)
STANDUP_INCLUDE_ADMINS=false

# Scheduler tuning (worker)
SCHEDULER_JOB_ATTEMPTS=3
SCHEDULER_BACKOFF_MS=30000
SCHEDULER_RECONCILE_MS=60000

# GitHub App
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Figma
FIGMA_ACCESS_TOKEN=
FIGMA_WEBHOOK_SECRET=

# Auth token signing key. Use a long random value in production.
JWT_SECRET=dev-secret-change-me

# Production (docker-compose.prod.yml on the VPS). DATABASE_URL, REDIS_URL and
# INTERNAL_API_URL are set by the compose file; IMAGE_TAG is set by CI.
POSTGRES_PASSWORD=
IMAGE_PREFIX=ghcr.io/fardannozami/team-assistant
API_PORT=4000
WEB_PORT=3000

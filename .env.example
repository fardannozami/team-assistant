# Database
DATABASE_URL=postgres://teamassistant:teamassistant@localhost:5432/teamassistant

# Redis
REDIS_URL=redis://localhost:6379

# API
PORT=4000
NODE_ENV=development

# WhatsApp (Baileys session path)
WHATSAPP_SESSION_PATH=./data/whatsapp-session

# AI provider (OpenAI-compatible)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Internal API access (worker -> api)
INTERNAL_API_URL=http://localhost:4000
INTERNAL_API_TOKEN=dev-internal-token

# Standup scheduler fallback (worker) - used only when no active schedule
# exists in the database. Admins configure schedules at runtime instead.
STANDUP_PROMPT_CRON=0 9 * * 1-5
STANDUP_PROMPT_TIMEZONE=Asia/Jakarta
STANDUP_REMINDER_CRON=30 10 * * 1-5
STANDUP_REMINDER_TIMEZONE=Asia/Jakarta

# Scheduler tuning (worker)
SCHEDULER_JOB_ATTEMPTS=3
SCHEDULER_BACKOFF_MS=30000
SCHEDULER_RECONCILE_MS=60000

# GitHub App
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Figma
FIGMA_ACCESS_TOKEN=
FIGMA_WEBHOOK_SECRET=

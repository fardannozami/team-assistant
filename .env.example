# Database
DATABASE_URL=postgres://teamassistant:teamassistant@localhost:5432/teamassistant

# Redis
REDIS_URL=redis://localhost:6379

# API
PORT=4000
NODE_ENV=development

# Web app URL (Google login redirects back here)
WEB_URL=http://localhost:3000

# Google OAuth login (leave empty to hide "Masuk dengan Google").
# Unknown Google accounts get their own new workspace as Owner. Set false to
# allow only existing users.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
GOOGLE_SIGNUP_ENABLED=true

# GitHub integration (one GitHub App for the whole server; each workspace
# installs it from Settings -> GitHub). In the App settings:
#   Callback URL      = <API URL>/github/setup
#   [x] Request user authorization (OAuth) during installation
#   Webhook URL       = <API URL>/github/webhook (secret = GITHUB_WEBHOOK_SECRET)
#   Permissions (read): Contents, Metadata, Pull requests, Issues
#   Events: Push, Pull request, Pull request review, Issues, Issue comment
# GITHUB_APP_PRIVATE_KEY is the PEM; newlines may be written as \n.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Figma: each workspace connects with a personal access token in
# Settings -> Figma (stored encrypted with ENCRYPTION_KEY). Files are polled
# hourly by the worker. Set PUBLIC_API_URL (the API's public base URL) to also
# register Figma webhooks at <PUBLIC_API_URL>/figma/webhook; they need a paid
# Figma plan and the token's webhooks:write scope.
PUBLIC_API_URL=

# WhatsApp (Baileys). Each workspace's bot session is stored in its own
# subdirectory of WHATSAPP_SESSIONS_DIR.
WHATSAPP_SESSIONS_DIR=./data/whatsapp-sessions
# Legacy single-bot session path; only migrated into a workspace on first start.
WHATSAPP_SESSION_PATH=./data/whatsapp-session

# AI: each workspace enters its own API key in Settings -> AI (stored
# encrypted with ENCRYPTION_KEY; changing it means keys must be re-entered).
ENCRYPTION_KEY=
# Optional server key (OpenAI-compatible). Only used for workspaces without
# their own key when AI_SHARED_KEY_FALLBACK=true.
AI_SHARED_KEY_FALLBACK=false
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Internal API access (worker -> api). Change INTERNAL_API_TOKEN in production.
INTERNAL_API_URL=http://localhost:4000
INTERNAL_API_TOKEN=dev-internal-token

# Standup schedules are per workspace (each new workspace gets 09:00 Mon-Fri).
# Daily report sent to each workspace's admins (worker).
DAILY_REPORT_CRON="0 17 * * 1-5"

# Include Owner/Admin employees in automatic standup prompts (default false)
STANDUP_INCLUDE_ADMINS=false

# Scheduler tuning (worker)
SCHEDULER_JOB_ATTEMPTS=3
SCHEDULER_BACKOFF_MS=30000
SCHEDULER_RECONCILE_MS=60000

# GitHub App
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Figma
FIGMA_ACCESS_TOKEN=
FIGMA_WEBHOOK_SECRET=

# Auth token signing key. Use a long random value in production.
JWT_SECRET=dev-secret-change-me

# Production (docker-compose.prod.yml on the VPS). DATABASE_URL, REDIS_URL and
# INTERNAL_API_URL are set by the compose file; IMAGE_TAG is set by CI.
POSTGRES_PASSWORD=
IMAGE_PREFIX=ghcr.io/fardannozami/team-assistant
API_PORT=4000
WEB_PORT=3000

# Naya (naya.digdaya.co): the AI team's office, a second web app on this same API.
# Set to its public URL to turn on "Buka Naya", Google sign-in from Naya and the
# WhatsApp keyword NAYA (a one-time sign-in link). Empty: Naya is off.
NAYA_WEB_URL=
# Other browser origins allowed to call the API (comma-separated). WEB_URL and NAYA_WEB_URL always are.
CORS_ORIGINS=

# Hermes (the AI team, container "hermes"; see docs/naya.md). The API reaches its bridge and
# API server over the Docker network "agents"; local `bun run dev` uses localhost.
HERMES_BRIDGE_URL=http://localhost:8700
HERMES_API_URL=http://localhost:8642
BRIDGE_TOKEN=dev-bridge-token-change-me
# The ops agent's whitelisted actions go through a read-only Docker API proxy.
DOCKER_PROXY_URL=http://localhost:2375
# Services the ops agent may see and restart (compose service names).
OPS_SERVICES=api,web,worker,naya
# Production only: OpenCode's data folder on the host (where `opencode` is run), so Naya's office
# shows OpenCode at a desk while someone uses it. Empty: no OpenCode desk.
OPENCODE_HOST_DATA=
# Production only: the activity-only copy of the host's Claude Code sessions, kept every minute by
# docker/claude-activity-sync.sh (e.g. /var/lib/claude-activity). Never ~/.claude itself: the
# agents in the hermes container would read the transcripts. Empty: no Claude Code desk.
CLAUDE_ACTIVITY_DIR=
# Only containers of this compose project (empty: any project's services with those names).
OPS_COMPOSE_PROJECT=
